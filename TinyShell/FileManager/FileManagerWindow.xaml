<Window x:Class="TinyShell.FileManager.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyShell // FILES" Height="620" Width="880"
        Background="{StaticResource BgVoid}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource MonoFont}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource GridLine}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="4,5"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#141F30"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1B2B45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Address bar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
      <Button Content="↑" Width="34" Style="{StaticResource NeonButtonGhost}" Click="Up_Click"/>
      <Button Content="⟳" Width="34" Style="{StaticResource NeonButtonGhost}" Click="Refresh_Click"/>
      <TextBox x:Name="PathBox" Width="600" Style="{StaticResource NeonTextBox}"
               Margin="8,0,0,0" KeyDown="PathBox_KeyDown"/>
      <Button Content="NEW FOLDER" Style="{StaticResource NeonButtonGhost}" Click="NewFolder_Click" Margin="8,0,0,0"/>
    </StackPanel>

    <!-- File list -->
    <ListView x:Name="FileList" Grid.Row="1" Background="Transparent" BorderThickness="1"
              BorderBrush="{StaticResource GridLine}"
              MouseDoubleClick="FileList_DoubleClick" MouseRightButtonUp="FileList_RightClick">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Name" Width="420">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding TypeLabel}"/>
          <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeLabel}"/>
          <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding ModifiedLabel}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0"
               Foreground="{StaticResource Muted}" FontSize="11"/>
  </Grid>
</Window>
