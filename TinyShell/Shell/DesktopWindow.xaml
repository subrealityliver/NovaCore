<Window x:Class="TinyShell.Shell.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="Black"
        KeyDown="DesktopWindow_KeyDown">

  <Grid x:Name="RootGrid" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
        MouseRightButtonUp="RootGrid_MouseRightButtonUp">
    <Grid.Background>
      <ImageBrush x:Name="WallpaperBrush" Stretch="UniformToFill"/>
    </Grid.Background>

    <ItemsControl x:Name="IconGrid">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="Tile" Width="88" Height="88" Background="Transparent" CornerRadius="4" Padding="4"
                  Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                  MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                  MouseMove="Tile_MouseMove"
                  MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                  MouseRightButtonUp="Tile_MouseRightButtonUp">
            <StackPanel IsHitTestVisible="False">
              <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,4"/>
              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="80"
                         TextTrimming="CharacterEllipsis" MaxHeight="32">
                <TextBlock.Effect>
                  <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
              </TextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
