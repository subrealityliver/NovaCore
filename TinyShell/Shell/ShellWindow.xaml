<Window x:Class="TinyShell.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True"
        Background="{StaticResource BgVoid}"
        AllowsTransparency="False">

  <Window.Resources>
    <DataTemplate x:Key="TaskTemplate">
      <Button Click="Task_Click" MouseRightButtonUp="Task_RightClick" Tag="{Binding}"
              Margin="3,6" Padding="9,4" Background="#0E1522"
              BorderBrush="{StaticResource GridLine}" BorderThickness="1" Cursor="Hand"
              Opacity="{Binding IsMinimized, Converter={StaticResource MinimizedOpacity}}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Magenta}"/>
                <Setter TargetName="b" Property="Effect" Value="{StaticResource MagentaGlow}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding Title}" MaxWidth="160" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFont}"
                     FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- Single-click launcher tile with right-click support -->
    <DataTemplate x:Key="AppTemplate">
      <Button Click="AppButton_Click" MouseRightButtonUp="AppButton_RightClick" Tag="{Binding}"
              Background="Transparent" BorderThickness="0" Cursor="Hand"
              HorizontalContentAlignment="Left" Padding="8,7">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#141F30"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"
                     FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="RootLayout" MouseRightButtonUp="RootLayout_MouseRightButtonUp">
    <!-- Bar content -->
    <Grid>
      <!-- edge-facing hairline glow -->
      <Border x:Name="EdgeGlow" VerticalAlignment="Top" Height="1"
              Background="{StaticResource Cyan}" Opacity="0.55"/>

      <Grid x:Name="ContentGrid" Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Start / launcher -->
        <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource NeonButtonPrimary}"
                Click="StartButton_Click" Visibility="Collapsed">
          <TextBlock Text="NOVA://" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"/>
        </Button>

        <!-- Running windows -->
        <ScrollViewer x:Name="TaskScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" Margin="10,0">
          <ItemsControl x:Name="TaskItems" ItemTemplate="{StaticResource TaskTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel x:Name="TaskStack" Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>

        <!-- Right cluster -->
        <StackPanel x:Name="RightCluster" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FilesButton" Style="{StaticResource NeonButtonGhost}"
                  Click="Files_Click" ToolTip="File manager" Visibility="Collapsed">
            <TextBlock Text="FILES" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
          </Button>
          <Button x:Name="DebloatButton" Style="{StaticResource NeonButtonGhost}"
                  Click="Debloat_Click" ToolTip="Debloat console" Visibility="Collapsed">
            <TextBlock Text="DBG" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
          </Button>
          <Button x:Name="MenuButton" Style="{StaticResource NeonButtonGhost}"
                  Click="Menu_Click" ToolTip="TinyShell menu" Visibility="Collapsed">
            <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="12"/>
          </Button>
          <Button x:Name="PowerButton" Style="{StaticResource NeonButtonGhost}"
                  Click="Power_Click" ToolTip="Power" Visibility="Collapsed">
            <TextBlock Text="⏻" FontFamily="Segoe UI Symbol" FontSize="12"/>
          </Button>
          <TextBlock x:Name="Clock" Foreground="{StaticResource Cyan}" FontFamily="{StaticResource MonoFont}"
                     FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0" TextAlignment="Right"/>
        </StackPanel>
      </Grid>

      <!-- Drag-to-resize grip on the inward-facing edge -->
      <Thumb x:Name="ResizeGrip" Height="4" VerticalAlignment="Top" Cursor="SizeNS"
             Background="Transparent" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    </Grid>

    <!-- Start menu popup (primary bar only) -->
    <Popup x:Name="StartPopup" PlacementTarget="{Binding ElementName=StartButton}"
           Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Cyan}"
              BorderThickness="1" CornerRadius="2" Width="460" Height="500" Margin="0,0,0,10">
        <Border.Effect>
          <DropShadowEffect Color="#00F0FF" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,0">
            <TextBlock Text="NOVA" Foreground="{StaticResource Cyan}" FontFamily="{StaticResource MonoFont}"
                       FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="CORE.LAUNCHER" Foreground="{StaticResource Muted}"
                       FontFamily="{StaticResource MonoFont}" FontSize="14" Margin="2,0,0,0"/>
          </StackPanel>

          <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource NeonTextBox}"
                   Margin="16,12,16,10" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="6,0,6,4">
            <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource AppTemplate}"/>
          </ScrollViewer>

          <!-- Power row at the bottom of the launcher, like a real Start menu -->
          <Border Grid.Row="3" BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="SLEEP" Style="{StaticResource NeonButtonGhost}" Click="Sleep_Click"/>
              <Button Content="RESTART" Style="{StaticResource NeonButtonGhost}" Click="Restart_Click"/>
              <Button Content="SHUT DOWN" Style="{StaticResource NeonButtonGhost}" Click="Shutdown_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</Window>
