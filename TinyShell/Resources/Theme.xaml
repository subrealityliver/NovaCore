<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TinyShell">

    <local:MinimizedOpacityConverter x:Key="MinimizedOpacity"/>

    <!-- ============ Palette ============ -->
    <Color x:Key="BgVoidColor">#05060A</Color>
    <Color x:Key="BgPanelColor">#0A0E17</Color>
    <Color x:Key="BgCardColor">#0F1420</Color>
    <Color x:Key="CyanColor">#00F0FF</Color>
    <Color x:Key="MagentaColor">#FF2E97</Color>
    <Color x:Key="AmberColor">#FFC400</Color>
    <Color x:Key="RedColor">#FF3B5C</Color>
    <Color x:Key="TextColor">#CFEFFF</Color>
    <Color x:Key="MutedColor">#5C7A8C</Color>
    <Color x:Key="GridLineColor">#141B29</Color>

    <SolidColorBrush x:Key="BgVoid" Color="{StaticResource BgVoidColor}"/>
    <SolidColorBrush x:Key="BgPanel" Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgCard" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="Magenta" Color="{StaticResource MagentaColor}"/>
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="GridLine" Color="{StaticResource GridLineColor}"/>

    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D1220" Offset="0"/>
        <GradientStop Color="#060810" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ Glow effects ============ -->
    <DropShadowEffect x:Key="CyanGlow" Color="{StaticResource CyanColor}"
                       BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
    <DropShadowEffect x:Key="MagentaGlow" Color="{StaticResource MagentaColor}"
                       BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
    <DropShadowEffect x:Key="SoftGlow" Color="{StaticResource CyanColor}"
                       BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>

    <!-- ============ Fonts ============ -->
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>

    <!-- ============ Neon button ============ -->
    <Style x:Key="NeonButton" TargetType="Button">
        <Setter Property="Background" Value="#0E1522"/>
        <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#141F30"/>
                            <Setter TargetName="b" Property="Effect" Value="{StaticResource CyanGlow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary "go" action - magenta accent -->
    <Style x:Key="NeonButtonPrimary" TargetType="Button" BasedOn="{StaticResource NeonButton}">
        <Setter Property="Foreground" Value="{StaticResource Magenta}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Magenta}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Ghost / secondary button, muted until hovered -->
    <Style x:Key="NeonButtonGhost" TargetType="Button" BasedOn="{StaticResource NeonButton}">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GridLine}"/>
    </Style>

    <!-- ============ CheckBox ============ -->
    <Style x:Key="NeonCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="box" Width="15" Height="15" BorderThickness="1.5"
                                BorderBrush="{StaticResource Muted}" Background="Transparent" CornerRadius="1">
                            <Path x:Name="mark" Data="M1,5 L4,8 L10,1" Stroke="{StaticResource Cyan}"
                                  StrokeThickness="2" Visibility="Collapsed" Margin="1"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            <Setter TargetName="box" Property="Effect" Value="{StaticResource SoftGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ GroupBox (category card) ============ -->
    <Style x:Key="NeonGroupBox" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource GridLine}"
                                BorderThickness="1" CornerRadius="3" Margin="0,10,0,0">
                            <Grid Margin="0,12,0,0">
                                <ContentPresenter Margin="14,4,14,14"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgVoid}" Padding="8,1" Margin="14,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{TemplateBinding Header}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="{StaticResource Cyan}"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TextBox ============ -->
    <Style x:Key="NeonTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgVoid}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GridLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                <Setter Property="Effect" Value="{StaticResource SoftGlow}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
